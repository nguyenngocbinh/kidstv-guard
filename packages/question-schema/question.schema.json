{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KidsTV Guard Question v1",
  "type": "object",
  "required": [
    "id",
    "subject",
    "topic",
    "difficulty",
    "type",
    "prompt",
    "options",
    "correctOptionIds",
    "active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "enum": [
        "math",
        "english",
        "spelling"
      ]
    },
    "topic": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "easy",
        "medium",
        "hard"
      ]
    },
    "type": {
      "enum": [
        "single_choice",
        "true_false"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "correctOptionIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}